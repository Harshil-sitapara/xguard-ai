# PostgreSQL
DATABASE_URL=postgresql+asyncpg://xguard:xguard_secret@postgres:5432/xguard
DB_CONNECT_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=8

# Kafka 
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_TRAFFIC=network-traffic
KAFKA_TOPIC_ALERTS=ids-alerts
KAFKA_GROUP_ID=xguard-consumer

# Security 
# Generate: openssl rand -hex 32
API_SECRET_KEY=CHANGE_ME

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://www.xguard-ai.tech","https://xguard-ai.tech"]

# Model 
BEST_MODEL_TYPE=xgboost
MODELS_DIR=/app/models

# App 
ENVIRONMENT=production
LOG_LEVEL=INFO
